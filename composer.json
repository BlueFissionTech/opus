{
    "name": "bluefission/opus",
    "type": "opus-project",
    "description": "Opus - The Blue Fission Development Platform.",
    "keywords": [
        "opus",
        "eidolon"
    ],
    "license": "Exclusive",
    "authors": [
        {
            "name": "Devon Scott",
            "email": "dscott@bluefission.com",
            "homepage": "http://bluefission.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/wise"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/vibrato"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/presence"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/synematic"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/annex-php-sdk"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/jenerator"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/opus-addon-hoom"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/opus-addon-kapsle"
        }
    ],
    "require": {
        "php": "^8.2",
        "bluefission/automata": "^1.0.0@alpha",
        "bluefission/bluecore": "^0.1.1@alpha",
        "bluefission/chronicler": "^0.1.2-alpha",
        "bluefission/develation": "^1.3.43",
        "bluefission/opus-addon-hoom": "dev-main",
        "bluefission/opus-addon-kapsle": "dev-main",
        "bluefission/presence": "0.1.0-alpha.3",
        "bluefission/simpleclients": "^0.1.0@alpha",
        "bluefission/synematic": "dev-main",
        "bluefission/synthetiq": "^0.1.0@alpha",
        "bluefission/vibrato": "dev-main",
        "composer/installers": "^1.11",
        "fakerphp/faker": "^1.24",
        "php-http/discovery": "^1.19",
        "symfony/http-client": "^7.3"
    },
    "require-dev": {
        "bluefission/wise": "0.1.0-alpha.2",
        "phpunit/phpunit": "^9.5"
    },
    "suggest": {
        "bluefission/wise": "Install to enable the intelligent shell, command processor, and resource mappings.",
        "cboden/ratchet": "Install to enable the optional terminal WebSocket transport when the host dependency graph is compatible."
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "use-github-api": false,
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true,
            "bluefission/bluecore": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "BlueFission\\": "core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/opus-addon.php"
    ],
    "archive": {
      "exclude": [
        ".babelrc"
      ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "audit:composer-vcs": "@php bin/audit-composer-vcs.php",
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}

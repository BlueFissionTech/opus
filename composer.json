{
    "name": "bluefission/opus",
    "type": "opus-project",
    "description": "Opus - The Blue Fission Development Platform.",
    "keywords": [
        "opus",
        "eidolon"
    ],
    "license": "Exclusive",
    "authors": [
        {
            "name": "Devon Scott",
            "email": "dscott@bluefission.com",
            "homepage": "http://bluefission.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/develation"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/bluecore"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/automata"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/wise"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/vibrato"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/presence"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/synematic"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/annex-php-sdk"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/simpleclients"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/synthetiq"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/jenerator"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/opus-addon-hoom"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/opus-addon-kapsle"
        }
    ],
    "require": {
        "php": "^8.2",
        "bluefission/automata": "dev-master",
        "bluefission/bluecore": "dev-main",
        "bluefission/develation": "dev-master as 1.3.36-alpha",
        "bluefission/opus-addon-hoom": "dev-main",
        "bluefission/opus-addon-kapsle": "dev-main",
        "bluefission/presence": "dev-main",
        "bluefission/simpleclients": "dev-master",
        "bluefission/synematic": "dev-main",
        "bluefission/vibrato": "dev-main",
        "bluefission/wise": "dev-main",
        "cboden/ratchet": "^0.4.4",
        "composer/installers": "^1.11",
        "fakerphp/faker": "^1.24",
        "php-http/discovery": "^1.19",
        "symfony/http-client": "^7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true,
            "bluefission/bluecore": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "BlueFission\\": "core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "archive": {
      "exclude": [
        ".babelrc"
      ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}
